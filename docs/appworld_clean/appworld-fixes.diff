@@ -98,6 +98,31 @@ if TYPE_CHECKING:
 TSQLModel = TypeVar("TSQLModel", bound="SQLModel")
 
 
+def _store_plain_datetimes_naive() -> None:
+    # Newer sqlmodel maps plain datetime fields to UTCDateTime, which rejects naive values.
+    # AppWorld datetimes are naive, so e.g. amazon.place_order failed on OrderItem.expected_delivery_at
+    # after the order row was already written. Keep the older naive DateTime column instead.
+    try:
+        import sqlmodel.main
+        from sqlalchemy import DateTime as SQLDateTime
+        from sqlmodel.sql.sqltypes import UTCDateTime
+    except ImportError:  # older sqlmodel: plain datetime fields are already naive
+        return
+    get_sqlalchemy_type = sqlmodel.main.get_sqlalchemy_type
+    if getattr(get_sqlalchemy_type, "stores_naive_datetimes", False):
+        return
+
+    def get_naive_sqlalchemy_type(field: Any) -> Any:
+        type_ = get_sqlalchemy_type(field)
+        return SQLDateTime(timezone=False) if isinstance(type_, UTCDateTime) else type_
+
+    get_naive_sqlalchemy_type.stores_naive_datetimes = True  # type: ignore[attr-defined]
+    sqlmodel.main.get_sqlalchemy_type = get_naive_sqlalchemy_type
+
+
+_store_plain_datetimes_naive()
+
+
 class SQLModel(Registrable, _SQLModel):
     app_name: ClassVar[str]
     table_name: ClassVar[str]
